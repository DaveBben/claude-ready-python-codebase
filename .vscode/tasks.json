{
    "version": "2.0.0",
    // Each problemMatcher turns a tool's `file:line` output into Problems-panel
    // entries and squiggles. ruff and mypy squiggle through their extensions;
    // these cover the checks with no extension. Squiggles last until the next run.
    "tasks": [
        {
            "label": "Lint: vulture + semgrep",
            "type": "shell",
            "command": "uv run vulture; uv run semgrep scan --config .semgrep --emacs --quiet",
            "presentation": { "reveal": "silent", "clear": true },
            "problemMatcher": [
                {
                    // tests/x.py:57: unused function 'f' (60% confidence)
                    "owner": "vulture",
                    "source": "vulture",
                    "severity": "error",
                    "fileLocation": ["autoDetect", "${workspaceFolder}"],
                    "pattern": { "regexp": "^(.+?):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 }
                },
                {
                    // src/x.py:2:7:error(rule-id):<code line>:<message>
                    "owner": "semgrep",
                    "source": "semgrep",
                    "fileLocation": ["autoDetect", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.+?):(\\d+):(\\d+):(\\w+)\\(([^)]+)\\):(.*)$",
                        "file": 1, "line": 2, "column": 3, "severity": 4, "code": 5, "message": 6
                    }
                }
            ]
        },
        {
            // The fast set: tests/integration and anything marked slow or integration stay
            // in the commit gate and CI, out of the edit-test loop.
            "label": "Test: unit",
            "type": "shell",
            "command": "uv run pytest tests/unit -m 'not slow and not integration' --tb=line",
            "group": { "kind": "test", "isDefault": true },
            "presentation": { "reveal": "always", "clear": true },
            "problemMatcher": {
                // /abs/path/tests/unit/test_x.py:12: AssertionError: message
                "owner": "pytest",
                "source": "pytest",
                "severity": "error",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": { "regexp": "^(/.+?\\.py):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 }
            }
        }
    ]
}
