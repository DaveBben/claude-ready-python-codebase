#!/usr/bin/env bash
# The repository's check. Stops at the first failure.
#   ./check         the plugin manifests, the script's lint and self-test, then a
#                   project made from the template with the steps SKILL.md gives,
#                   and that project's own ./check
#   ./check --full  ./check, then pip-audit in that project, reported and not
#                   gated. Its gitleaks and mutmut steps need a branch history
#                   a fresh project lacks.
set -euo pipefail
cd "$(dirname "$0")"

mode=${1:-}
case $mode in
  "" | --full) ;;
  *) echo "usage: ./check [--full]" >&2; exit 2 ;;
esac

skill=skills/python-template/python-template
uv run --no-project --quiet python - "$skill" <<'PY'
import json, re, sys
from pathlib import Path
skill = Path(sys.argv[1])
front = (skill / "SKILL.md").read_text().split("---")[1]
name = re.search(r"^name: (.+)$", front, re.M).group(1)
desc = re.search(r'^description: "(.+)"$', front, re.M).group(1)
versions = {
    "SKILL.md": re.search(r'^  version: "(.+)"$', front, re.M).group(1),
    "plugin.json": json.loads(Path("plugins/python-template/.claude-plugin/plugin.json").read_text())["version"],
    "marketplace.json": json.loads(Path(".claude-plugin/marketplace.json").read_text())["plugins"][0]["version"],
}
errors = []
if name != skill.name:
    errors.append(f"SKILL.md name {name!r} must equal its directory {skill.name!r}")
if len(desc) > 1024:
    errors.append(f"SKILL.md description is {len(desc)} characters; the limit is 1024")
if len(set(versions.values())) != 1:
    errors.append(f"versions differ, bump them together: {versions}")
sys.exit("\n".join(errors) or None)
PY

ruff="uv run --project $skill/assets/project --quiet ruff"
$ruff check --config ruff.toml "$skill/scripts"
$ruff format --check --config ruff.toml "$skill/scripts"
uv run --quiet "$skill/scripts/new_project.py" --self-test

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
uv run --quiet "$skill/scripts/new_project.py" "$tmp/p" acme_tools "Tools for Acme." "Acme Ltd"
cd "$tmp/p"
uv lock --quiet
uv sync --quiet
uv run ruff check --fix --quiet . && uv run ruff format --quiet .
./check

if [ "$mode" = --full ]; then
  # Reported, not gated, as in the template's own ./check --full.
  uv run pip-audit --skip-editable || echo "pip-audit: not gated; see the template's ./check for what to do"
fi
