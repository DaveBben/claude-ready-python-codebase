{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./check)",
      "Bash(./check --full)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run ruff:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Edit(./uv.lock)",
      "Write(./uv.lock)",
      "Edit(./.git/**)",
      "Write(./.git/**)"
    ]
  },
  "hooks": {
    "Stop": [{
      "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.py stop", "timeout": 600}]
    }],
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py", "timeout": 30}]
    }, {
      "matcher": "Bash",
      "hooks": [{"type": "command", "if": "Bash(*create*)", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.py pr", "timeout": 3600}]
    }, {
      "matcher": "mcp__.*(pull|merge)_request.*",
      "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.py pr", "timeout": 3600}]
    }],
    "PostToolUse": [{
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh", "timeout": 60}]
    }]
  }
}
